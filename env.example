# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-replace-with-a-secure-random-secret-key-32chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (Default SQLite, or postgres://user:password@localhost:5432/dbname)
DATABASE_URL=sqlite:///db.sqlite3

# Ollama LLM Configuration
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=60

# Assessment Engine Configuration
# Options: ollama | t5 | fallback
GRAMMAR_CORRECTION_PROVIDER=ollama

# Speech Recognition Provider
# Options: whisper | mock | speech_recognition
SPEECH_RECOGNITION_PROVIDER=whisper
WHISPER_MODEL=base

# Upload and Security Constraints
MAX_AUDIO_UPLOAD_MB=20
MAX_RECORDING_DURATION_SECONDS=180

# Storage and Logging
MEDIA_ROOT=media
LOG_LEVEL=INFO
